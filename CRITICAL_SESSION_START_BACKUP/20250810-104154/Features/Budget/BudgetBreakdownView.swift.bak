struct PaymentMethodSpendingRowView: View {
    let paymentMethod: PaymentMethod
    let totalSpent: Double
    let receiptCount: Int
    let percentage: Double
    let action: () -> Void
    
    var body: some View {
        Button(action: action) {
            HStack {
                HStack(spacing: 12) {
                    Image(systemName: paymentMethodIcon(for: paymentMethod))
                        .font(.title2)
                        .foregroundColor(paymentMethodColor(for: paymentMethod))
                        .frame(width: 30)
                    Text(paymentMethod.displayName)
                        .font(.headline)
                        .fontWeight(.semibold)
                }
                
                Spacer()
                
                VStack(alignment: .trailing, spacing: 4) {
                    Text(totalSpent.formatAsCurrency())
                        .font(.headline)
                        .fontWeight(.semibold)
                    
                    Text("\(Int(percentage * 100))%")
                        .font(.caption)
                        .foregroundColor(.secondary)
                }
            }
            .padding()
            .background(Color(.systemGray6))
            .cornerRadius(12)
        }
        .buttonStyle(PlainButtonStyle())
    }
    
    private func paymentMethodIcon(for type: PaymentType) -> String {
        switch type {
        case .creditCard: return "creditcard.fill"
        case .debitCard: return "creditcard.fill"
        case .cash: return "dollarsign.circle.fill"
        case .check: return "checkmark.rectangle.fill"
        case .bankTransfer: return "building.columns.fill"
        default: return "questionmark.circle.fill"
        }
    }
    
    private func paymentMethodColor(for paymentMethod: PaymentMethod) -> Color {
        switch paymentMethod.type {
        case .creditCard: return .blue
        case .debitCard: return .green
        case .cash: return .orange
        case .check: return .purple
        case .bankTransfer: return .indigo
        default: return .gray
        }
    }
}

