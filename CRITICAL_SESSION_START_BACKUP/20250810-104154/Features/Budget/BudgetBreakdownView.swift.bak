struct PaymentMethodReceiptRowCard: View {
    let receipt: Receipt
    
    var body: some View {
        HStack {
            HStack(spacing: 12) {
                Image(systemName: paymentMethodIcon(for: receipt.paymentMethod))
                    .font(.title2)
                    .foregroundColor(paymentMethodColor(for: receipt.paymentMethod))
                    .frame(width: 30)
                Text(receipt.paymentMethod.displayName)
                    .font(.headline)
                    .fontWeight(.semibold)
            }
            
            Spacer()
            
            VStack(alignment: .trailing, spacing: 4) {
                Text(receipt.amount.formatAsCurrency())
                    .font(.headline)
                    .fontWeight(.semibold)
                    .foregroundColor(receipt.isReturn ? .red : .primary)
                
                Text(receipt.category.rawValue)
                    .font(.caption)
                    .foregroundColor(.secondary)
            }
        }
        .padding()
        .background(Color(.systemGray6))
        .cornerRadius(12)
    }
    
    private func paymentMethodIcon(for paymentMethod: PaymentMethod) -> String {
        switch paymentMethod.type {
        case .creditCard: return "creditcard.fill"
        case .debitCard: return "creditcard.fill"
        case .cash: return "dollarsign.circle.fill"
        case .check: return "checkmark.rectangle.fill"
        case .bankTransfer: return "building.columns.fill"
        default: return "questionmark.circle.fill"
        }
    }
    
    private func paymentMethodColor(for paymentMethod: PaymentMethod) -> Color {
        switch paymentMethod.type {
        case .creditCard: return .blue
        case .debitCard: return .green
        case .cash: return .orange
        case .check: return .purple
        case .bankTransfer: return .indigo
        default: return .gray
        }
    }
}

