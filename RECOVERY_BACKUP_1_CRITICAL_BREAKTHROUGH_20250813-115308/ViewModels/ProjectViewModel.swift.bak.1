            testReport += "   Zone setup completed: \(isUsingCloudKitForOrganizationData ? "✅" : "❌")\n"
            
            if let error = zoneSetupError {
                testReport += "   Error: \(error)\n"
            }
            
            // Test zone diagnostics
            testReport += "\n2. Running zone diagnostics...\n"
            let diagnostics = await getCloudKitZoneDiagnostics()
            testReport += diagnostics
            
            // Test share URL generation
            testReport += "\n3. Testing share URL generation...\n"
            let shareURL = await getOrganizationCloudKitShareURL()
            if let shareURL = shareURL {
                testReport += "   Share URL: ✅ Generated successfully\n"
                testReport += "   URL: \(shareURL)\n"
            } else {
                testReport += "   Share URL: ❌ Could not generate\n"
            }
            
            testReport += "\n🏁 TEST COMPLETE\n"
            
            // Check if zone is ready for collaboration
            let isCollaborationReady = isUsingCloudKitForOrganizationData && shareURL != nil
            testReport += "Zone ready for collaboration: \(isCollaborationReady ? "✅" : "❌")\n"
            
        } catch {
            testReport += "❌ Test failed with error: \(error.localizedDescription)\n"
        }
        
        return testReport
    }
    
    /// Force recreate the CloudKit zone (for testing)
    func forceRecreateCloudKitZone() async -> String {
        guard let organizationID = currentOrganizationID else {
            return "❌ No organization ID set"
        }
        
        var report = "🔄 FORCE RECREATING CLOUDKIT ZONE:\n\n"
        
        do {
            let container = CKContainer(identifier: "iCloud.com.rheirhome.rheirhomeapp")
            let privateDB = container.privateCloudDatabase
            
            let zoneName = "org-shared-\(organizationID)"
            let zoneID = CKRecordZone.ID(zoneName: zoneName)
            
            // Step 1: Try to delete existing zone
            report += "1. Attempting to delete existing zone...\n"
            do {
                try await privateDB.deleteRecordZone(withID: zoneID)
                report += "   ✅ Deleted existing zone\n"
            } catch {
                report += "   ⚠️ Zone deletion failed (may not exist): \(error.localizedDescription)\n"
            }
            
            // Step 2: Wait a moment for CloudKit to process
            try await Task.sleep(nanoseconds: 2_000_000_000) // 2 seconds
            
            // Step 3: Create fresh zone
            report += "\n2. Creating fresh zone...\n"
            await setupCloudKitZoneForOrganization(organizationID)
            report += "   Zone creation: \(isUsingCloudKitForOrganizationData ? "✅" : "❌")\n"
            
            if let error = zoneSetupError {
                report += "   Error: \(error)\n"
            }
            
            // Step 4: Test the new zone
            report += "\n3. Testing new zone...\n"
            let testResult = await testCloudKitZoneSetup()
            report += testResult
            
        } catch {
            report += "❌ Zone recreation failed: \(error.localizedDescription)\n"
        }
        
        return report
    }
    
    /// Manually create a fresh CloudKit zone for the current organization (for testing)
    func manuallyCreateFreshZone() async -> String {
        guard let organizationID = currentOrganizationID else {
            return "❌ No organization ID set"
        }
        
        var report = "🏗️ MANUAL ZONE CREATION:\n\n"
        report += "Organization ID: \(organizationID.prefix(8))...\n"
        
        do {
            let container = CKContainer(identifier: "iCloud.com.rheirhome.rheirhomeapp")
            let privateDB = container.privateCloudDatabase
            
            // Step 1: Check account status
            report += "\n1. Checking CloudKit account...\n"
            let accountStatus = try await container.accountStatus()
            report += "   Account status: \(accountStatus == .available ? "✅ Available" : "❌ \(accountStatus)")\n"
            
            guard accountStatus == .available else {
                report += "❌ Cannot create zone - iCloud account not available\n"
                return report
            }
            
            // Step 2: List existing zones
            report += "\n2. Checking existing zones...\n"
            let existingZones = try await privateDB.allRecordZones()
            report += "   Found \(existingZones.count) existing zones\n"
            
            let zoneName = "org-shared-\(organizationID)"
            let zoneID = CKRecordZone.ID(zoneName: zoneName)
            
            if let existingZone = existingZones.first(where: { $0.zoneID.zoneName == zoneName }) {
                report += "   Zone already exists: \(zoneName)\n"
                
                // Check if it has sharing
                let hasShare = try await checkZoneHasShare(existingZone, container: container)
                report += "   Zone has share: \(hasShare ? "✅ Yes" : "❌ No")\n"
                
                if !hasShare {
                    report += "\n3. Creating share for existing zone...\n"
                    try await createShareForExistingZone(existingZone, organizationID: organizationID, container: container)
                    report += "   ✅ Share created successfully\n"
                }
            } else {
                // Step 3: Create new zone
                report += "\n3. Creating new zone...\n"
                let newZone = CKRecordZone(zoneID: zoneID)
                let savedZone = try await privateDB.save(newZone)
                report += "   ✅ Zone created: \(savedZone.zoneID.zoneName)\n"
                
                // Step 4: Create share
                report += "\n4. Creating share for new zone...\n"
                try await createShareForExistingZone(savedZone, organizationID: organizationID, container: container)
                report += "   ✅ Share created successfully\n"
            }
            
            // Step 5: Test share URL generation
            report += "\n5. Testing share URL generation...\n"
            let shareURL = await getOrganizationCloudKitShareURL()
            if let shareURL = shareURL {
                report += "   ✅ Share URL generated\n"
                report += "   URL: \(shareURL)\n"
            } else {
                report += "   ❌ Could not generate share URL\n"
            }
            
            // Step 6: Enable CloudKit mode
            isUsingCloudKitForOrganizationData = true
            report += "\n6. Enabled CloudKit mode\n"
            
            report += "\n🎉 Manual zone creation completed successfully!\n"
            
        } catch {
            report += "\n❌ Manual zone creation failed: \(error.localizedDescription)\n"
        }
        
        return report
    }
    
    // MARK: - Project Assignment Management
    
    /// Set current user's project assignments
    func setUserProjectAssignments(_ projectIDs: [String]) {
        userProjectAssignments = projectIDs
        print("📋 ProjectViewModel: Set user project assignments to \(projectIDs.count) projects")
        
        // Trigger projects filtering
        filterProjectsByAssignments()
    }
    
    /// Filter projects based on user assignments
    private func filterProjectsByAssignments() {
        // This will be called automatically when projects are loaded
        // The filtering happens in the computed property `accessibleProjects`
        objectWillChange.send()
    }
    
    /// Projects that current user has access to based on role and assignments
    var accessibleProjectsByRole: [Project] {
        // Admins see all projects
        if getCurrentUserRole() == .admin {
            return organizationProjects
        }
        
        // Non-admins only see assigned projects
        if userProjectAssignments.isEmpty {
            // No assignments = no projects visible (except for new users)
            return []
        }
        
        return organizationProjects.filter { project in
            userProjectAssignments.contains(project.id.uuidString)
        }
    }
    
    /// Get project access summary for current user
    func getProjectAccessSummary() -> String {
        if getCurrentUserRole() == .admin {
            return "Full access to all \(projects.count) projects"
        }
        
        // Filter projects by assignments and role
        let accessibleCount = accessibleProjectsByRole.count
        let totalCount = organizationProjects.count
        
        if accessibleCount == 0 {
            return "No project assignments. Contact admin for access."
        } else if accessibleCount == totalCount {
            return "Access to all \(totalCount) projects"
        } else {
            return "Access to \(accessibleCount) of \(totalCount) projects"
        }
    }
    
    func removeCloudKitOrganizationData() async {
        do {
            // Clear local data
            organizationProjects.removeAll()
            
            // Try to check if zone has share
            if let organizationID = currentOrganizationID {
                let shareURL = await getOrganizationCloudKitShareURL()
                if shareURL != nil {
                    print(" Organization has active share - data clearing completed locally")
                } else {
                    print(" No active share found")
                }
            }
            
            print(" Organization data cleared locally")
            
        }
    }
}